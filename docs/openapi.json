  "components": {
    "schemas": {
      "AddClassesRequest": {
        "properties": {
          "count": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Count",
            "description": "Number of practical lessons to add"
          }
        },
        "type": "object",
        "required": [
          "count"
        ],
        "title": "AddClassesRequest"
      },
      "DgtExamAppointment": {
        "properties": {
          "appointment_id": {
            "type": "string",
            "title": "Appointment Id"
          },
          "student_dni": {
            "type": "string",
            "title": "Student Dni"
          },
          "exam_type": {
            "type": "string",
            "enum": [
              "THEORETICAL",
              "PRACTICAL"
            ],
            "title": "Exam Type"
          },
          "appointment_date": {
            "type": "string",
            "title": "Appointment Date",
            "description": "Date of the scheduled exam in DD-MM-YYYY format"
          },
          "center_location": {
            "type": "string",
            "title": "Center Location",
            "default": "Centro de Examenes DGT Madrid-Mostoles"
          },
          "status": {
            "type": "string",
            "enum": [
              "SCHEDULED",
              "PASSED",
              "FAILED",
              "CANCELLED"
            ],
            "title": "Status",
            "default": "SCHEDULED"
          }
        },
        "type": "object",
        "required": [
          "student_dni",
          "exam_type",
          "appointment_date"
        ],
        "title": "DgtExamAppointment",
        "description": "Represents an official DGT driving test appointment scheduled for a student."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Instructor": {
        "properties": {
          "instructor_id": {
            "type": "string",
            "title": "Instructor Id"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          },
          "assigned_vehicle_plate": {
            "type": "string",
            "title": "Assigned Vehicle Plate",
            "default": "0000-XXX"
          },
          "vehicle_model": {
            "type": "string",
            "title": "Vehicle Model",
            "default": "Standard Vehicle"
          },
          "itv_expiration_date": {
            "type": "string",
            "title": "Itv Expiration Date",
            "default": "31-12-2026"
          },
          "total_fuel_expenses": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Total Fuel Expenses",
            "default": "0.00"
          }
        },
        "type": "object",
        "required": [
          "full_name"
        ],
        "title": "Instructor",
        "description": "Instructor domain model containing fleet asset assignments and expense compliance."
      },
      "InvoiceCalculation": {
        "properties": {
          "invoice_number": {
            "type": "string",
            "title": "Invoice Number"
          },
          "invoice_date": {
            "type": "string",
            "title": "Invoice Date"
          },
          "student_dni": {
            "type": "string",
            "title": "Student Dni"
          },
          "student_name": {
            "type": "string",
            "title": "Student Name"
          },
          "target_license": {
            "type": "string",
            "title": "Target License"
          },
          "enrollment_fee": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Enrollment Fee"
          },
          "included_classes": {
            "type": "integer",
            "title": "Included Classes"
          },
          "completed_classes": {
            "type": "integer",
            "title": "Completed Classes"
          },
          "extra_classes_count": {
            "type": "integer",
            "title": "Extra Classes Count"
          },
          "extra_classes_cost": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Extra Classes Cost"
          },
          "total_exams_count": {
            "type": "integer",
            "title": "Total Exams Count"
          },
          "total_exams_cost": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Total Exams Cost"
          },
          "subtotal_amount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Subtotal Amount"
          },
          "vat_percentage": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Vat Percentage",
            "default": "0.21"
          },
          "vat_amount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Vat Amount"
          },
          "total_with_vat": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Total With Vat"
          },
          "advances_paid": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Advances Paid"
          },
          "pending_balance": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Pending Balance"
          }
        },
        "type": "object",
        "required": [
          "student_dni",
          "student_name",
          "target_license",
          "enrollment_fee",
          "included_classes",
          "completed_classes",
          "extra_classes_count",
          "extra_classes_cost",
          "total_exams_count",
          "total_exams_cost",
          "subtotal_amount",
          "vat_amount",
          "total_with_vat",
          "advances_paid",
          "pending_balance"
        ],
        "title": "InvoiceCalculation",
        "description": "Immutable accounting statement summarizing training costs, taxes, and balance reconciliation."
      },
      "KPIDashboardSummary": {
        "properties": {
          "total_gross": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Total Gross"
          },
          "total_vat": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Total Vat"
          },
          "total_pending": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Total Pending"
          },
          "completed_lessons_sum": {
            "type": "integer",
            "title": "Completed Lessons Sum"
          },
          "license_distribution": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "License Distribution"
          },
          "total_students": {
